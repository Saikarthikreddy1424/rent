# ==========================================
# RentEase Project Environment Variables
# ==========================================

# 1. Express Backend (server/.env)
PORT=5000
NODE_ENV=development

# 2. Supabase Configuration (PostgreSQL Database & Auth & Storage)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# Leave blank or unconfigured to automatically run in offline development mode!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. React Frontend (client/.env)
VITE_API_URL=http://localhost:5000/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
